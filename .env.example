# =============================================================================
# Frappe CRM — Variables de entorno
# Copiar a .env y rellenar antes de levantar el stack
# =============================================================================

# --- Requeridas ---
SITE_NAME=crm.elevateai.es
HOST_NAME=https://crm.elevateai.es
DB_PASSWORD=                          # openssl rand -hex 16
ADMIN_PASSWORD=                       # password del usuario Administrator

# --- Imagen (por defecto usa GHCR) ---
# CRM_IMAGE=ghcr.io/jfernandez-elevateai/frappe-crm
# CRM_TAG=latest

# --- Migración (solo si se restaura un backup existente) ---
# ENCRYPTION_KEY=                     # de site_config.json del servidor anterior

# --- SMTP ---
# MAIL_SERVER=smtp.zoho.eu
# MAIL_LOGIN=jfernandez@elevateai.es
# MAIL_PASSWORD=
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_FROM_NAME=ElevateAI

# --- Twilio (opcional) ---
# TWILIO_API_KEY=                     # api_key_twilio (SKe11f..)

# --- Proxy ---
# UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
# PROXY_READ_TIMEOUT=120
# CLIENT_MAX_BODY_SIZE=50m
